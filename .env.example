# ForeBuddies Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real keys!

# ===========================================
# SUPABASE (Required for production)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side keys (for edge functions, not exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ===========================================
# PRIVY (Required for Web3 auth)
# ===========================================
# Get from: https://dashboard.privy.io
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# ===========================================
# SOLANA (Required for token integration)
# ===========================================
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet: https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ForePoints SPL Token mint address (created on Pump.fun)
EXPO_PUBLIC_FOREPOINTS_TOKEN_MINT=your-token-mint-address

# ===========================================
# AI SERVICES (Optional - for AI features)
# ===========================================
EXPO_PUBLIC_VIBECODE_OPENAI_API_KEY=your-openai-api-key
EXPO_PUBLIC_VIBECODE_ANTHROPIC_API_KEY=your-anthropic-api-key
EXPO_PUBLIC_VIBECODE_GROK_API_KEY=your-grok-api-key
EXPO_PUBLIC_VIBECODE_GOOGLE_API_KEY=your-google-api-key
EXPO_PUBLIC_VIBECODE_ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ===========================================
# DATABASE (Server-side only - for migrations)
# ===========================================
POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_PASSWORD=your-database-password
POSTGRES_USER=postgres
POSTGRES_URL=postgres://postgres:password@host:6543/postgres
